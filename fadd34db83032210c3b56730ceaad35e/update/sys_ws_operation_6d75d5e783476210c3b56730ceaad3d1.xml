        <name>Create Task</name>
        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {
	var body = request.body.data;

	var gr = new GlideRecord('x_1790233_event_ma_event_task');
	gr.initialize();
    gr.setValue('event_id', body.event_id);
    gr.setValue('u_task_name', body.task_name);
    gr.setValue('assigned_to', body.assigned_to);
    gr.setValue('due_date', body.due_date);
    gr.insert();

    response.setStatus(201);
    return { result: "Task created successfully" };
})(request, response);]]></operation_script>
