        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    try {
        var rm = new sn_ws.RESTMessageV2('Notify External - Task', 'Send Task');

        rm.setStringParameterNoEscape('task_name', current.u_task_name);
        rm.setStringParameterNoEscape('event_id', current.event_id);
        rm.setStringParameterNoEscape('assigned_to', current.assignment_to.getDisplayValue());
        rm.setStringParameterNoEscape('due_date', current.due_date);

        var response = rm.execute();
        var responseBody = response.getBody();
        gs.info("Task Notification Response: " + responseBody);
    } catch (ex) {
        gs.error("Error sending task notification: " + ex.message);
    }
})(current, previous);
]]></script>
