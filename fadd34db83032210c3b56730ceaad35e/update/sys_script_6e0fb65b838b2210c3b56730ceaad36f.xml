        <script><![CDATA[(function executeRule(current, previous) {

    // Default to 0 if any currency field is null
    var total = current.total_budget || 0;
    var spent = current.amount_spend || 0;

    // Calculate the remaining amount
    var remaining = total - spent;

    // Assign it to the currency field
    current.amount_remaining = remaining;

})(current, previous);
