        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Only notify if event was just scheduled and email exists
    if (current.event_status == 'scheduled' &&
        previous.event_status != 'scheduled' &&
        current.email) {

        var emailAddress = current.getValue('email');
        gs.eventQueue('event.scheduled.notify', current, emailAddress,'');
    }
})(current, previous);
]]></script>
