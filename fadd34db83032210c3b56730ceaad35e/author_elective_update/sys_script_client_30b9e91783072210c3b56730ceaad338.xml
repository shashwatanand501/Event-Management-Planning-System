        <messages/>
        <name>client script to validate that the end</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        return;
    }

    // Get the values of start_time and end_time
    var startTime = g_form.getValue('start_time');
    var endTime = g_form.getValue('end_time');

    // Convert to Date objects
    var start = new Date(startTime);
    var end = new Date(endTime);

    // Compare times
    if (end < start) {
        g_form.showFieldMsg('end_time', 'End time cannot be before start time.', 'error');
        g_form.setValue('end_time', ''); // Optionally reset the end_time field
    } else {
        g_form.hideFieldMsg('end_time');
    }
}
]]></script>
